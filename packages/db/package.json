{
  "name": "@mentorhub/db",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "vitest run --coverage",
    "migrate": "tsx src/scripts/migrate.ts up",
    "migrate:down": "tsx src/scripts/migrate.ts down",
    "migration:create": "tsx src/scripts/migrate.ts create",
    "migrate:status": "tsx src/scripts/migrate.ts status"
  },
  "dependencies": {
    "@mikro-orm/core": "^7.2.5",
    "@mikro-orm/migrations": "^7.2.5",
    "@mikro-orm/postgresql": "^7.2.5"
  },
  "devDependencies": {
    "@vitest/coverage-v8": "^5.0.5",
    "tsx": "^4.23.15",
    "vitest": "^5.0.5"
  }
}
