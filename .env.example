# Defaults below match docker-compose.yml, so only AUTH_SECRET is required for local work
# ("make setup" generates it into packages/app/.env.local when missing).
# To override: export in your shell (used by migrations and the app), or put them in
# packages/app/.env.local (read by Next.js only). Never commit real .env files.
DATABASE_URL=postgresql://mentorhub:mentorhub@localhost:5433/mentorhub
DB_POOL_MAX=10

# Sessions: signs the JWT in the mh_session cookie. At least 32 characters, random
# (e.g. `openssl rand -hex 32`). Required in every environment except NODE_ENV=test.
AUTH_SECRET=
# Public origin of the app — sign-in links are built on it.
APP_URL=http://localhost:3000
# Mail port adapter: `mock` (the only one so far) logs a redacted line and, when
# MAIL_OUTBOX_FILE is set, appends each message as a JSON line there (how the tests read links).
# `mock` is refused in production unless ALLOW_TEST_ADAPTERS=1 (integration suite only).
MAIL_ADAPTER=mock
MAIL_OUTBOX_FILE=
ALLOW_TEST_ADAPTERS=0
