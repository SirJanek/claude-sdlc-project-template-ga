# Defaults below match docker-compose.yml, so nothing is required for local work.
# To override: export in your shell (used by migrations and the app), or put them in
# packages/app/.env.local (read by Next.js only). Never commit real .env files.
DATABASE_URL=postgresql://mentorhub:mentorhub@localhost:5433/mentorhub
DB_POOL_MAX=10
